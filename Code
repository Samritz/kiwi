<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kiwi Yogurt AI Prototype</title>
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            text-align: center;
            background-color: #fff;
            margin: 0;
            padding: 0;
        }
        .header {
            background: #ff6699;
            color: white;
            padding: 20px;
            font-size: 24px;
        }
        .container {
            max-width: 1000px;
            margin: auto;
            padding: 20px;
        }
        .hero {
            background-image: url('https://source.unsplash.com/1000x400/?frozenyogurt');
            background-size: cover;
            background-position: center;
            height: 300px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 36px;
            font-weight: bold;
            text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);
        }
        .section {
            margin-top: 30px;
            padding: 20px;
            background: #ffe6e6;
            border-radius: 10px;
        }
        button {
            padding: 10px 20px;
            background-color: #ff3366;
            color: white;
            border: none;
            cursor: pointer;
            margin: 5px;
            font-size: 18px;
            border-radius: 5px;
        }
        button:hover {
            background-color: #cc0052;
        }
        .image-container img {
            width: 250px;
            height: auto;
            border-radius: 15px;
            margin: 10px;
        }
    </style>
</head>
<body>
    <div class="header">Kiwi Yogurt AI Prototype</div>
    <div class="hero">Delicious AI-Powered Yogurt Choices</div>
    
    <div class="container">
        <div class="section">
            <h2>Choose a Preloaded Customer Account</h2>
            <button onclick="loadProfile('User1')">User 1</button>
            <button onclick="loadProfile('User2')">User 2</button>
            <button onclick="loadProfile('User3')">User 3</button>
        </div>
        
        <div class="section">
            <h2>Flavor Recommendations</h2>
            <p id="recommendations">Select a user to see their recommendations.</p>
            <button onclick="showSurpriseMe()">Surprise Me!</button>
        </div>
        
        <div class="section">
            <h2>Inventory Status</h2>
            <p id="inventory">Click below to check stock levels.</p>
            <button onclick="showInventory()">Check Inventory</button>
        </div>
        
        <div class="section">
            <h2>Loyalty Program</h2>
            <p id="loyalty">Select a user to view their rewards.</p>
        </div>
    </div>

    <script>
        const userProfiles = {
            "User1": {
                "recommendations": "Recommended Flavors: Strawberry, Mango, Vanilla.",
                "loyalty": "Loyalty Points: 120 - Eligible for a free topping!"
            },
            "User2": {
                "recommendations": "Recommended Flavors: Chocolate, Peanut Butter, Coffee.",
                "loyalty": "Loyalty Points: 200 - Eligible for a free yogurt!"
            },
            "User3": {
                "recommendations": "Recommended Flavors: Green Tea, Blueberry, Coconut.",
                "loyalty": "Loyalty Points: 50 - 50 more points for a discount!"
            }
        };

        function loadProfile(user) {
            document.getElementById("recommendations").innerText = userProfiles[user].recommendations;
            document.getElementById("loyalty").innerText = userProfiles[user].loyalty;
        }

        function showSurpriseMe() {
            const flavors = ["Raspberry", "Cookies & Cream", "Salted Caramel", "Lemon", "Hazelnut"];
            const randomFlavor = flavors[Math.floor(Math.random() * flavors.length)];
            alert("Surprise Flavor: " + randomFlavor);
        }

        function showInventory() {
            document.getElementById("inventory").innerText = "Low Stock: Chocolate, Out of Stock: Mango, Available: All Other Flavors";
        }
    </script>
</body>
</html>
